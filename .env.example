# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
# For a local `npx prisma dev` instance specifically, append the pool-tuning
# params it advertises itself (connection_limit=10&connect_timeout=0&
# max_idle_connection_lifetime=0&pool_timeout=0&socket_timeout=0) — without
# them, long-running commands (e.g. `next build`'s static-generation pass)
# can hit `ConnectionClosed`/P1017 errors from idle connections being
# dropped mid-run.
DATABASE_URL="postgresql://user:password@localhost:5432/tripnexio?schema=public"

# Signs the staff CRM session JWT (src/lib/auth/session.ts). Generate a
# fresh one per environment, e.g. `openssl rand -base64 32`.
STAFF_SESSION_SECRET="replace-with-a-random-32-byte-base64-value"

# Signs the customer-facing (website login/register) session JWT
# (src/lib/auth/customer-session.ts) — separate from STAFF_SESSION_SECRET
# since these are two independent session systems. Generate a fresh one per
# environment, e.g. `openssl rand -base64 32`.
CUSTOMER_SESSION_SECRET="replace-with-a-different-random-32-byte-base64-value"

# Razorpay (src/lib/payments/) — TODO: client provides real values from
# their Razorpay Dashboard (Settings > API Keys for the first two, Settings
# > Webhooks > "Secret" for the third, once a webhook pointing at
# https://<your-domain>/api/webhooks/razorpay is configured there).
# Until all three are filled in, the app automatically falls back to
# MockPaymentGateway (src/lib/payments/mock-gateway.ts) so payment-link
# creation and webhook handling can still be developed/tested locally —
# see src/lib/payments/get-gateway.ts. Use rzp_test_ keys in non-production
# environments; never commit real keys to this file (only .env.example is
# tracked in git, .env itself is gitignored).
RAZORPAY_KEY_ID="TODO: client provides"
RAZORPAY_KEY_SECRET="TODO: client provides"
RAZORPAY_WEBHOOK_SECRET="TODO: client provides"

# Resend (src/lib/email/) — TODO: client provides a real API key from their
# Resend Dashboard (API Keys) once the sending domain below is verified
# there (see docs/deployment/EMAIL_SETUP.md for the DNS records to add).
# Until RESEND_API_KEY is filled in, the app logs emails to the server
# console instead of sending them — see src/lib/email/get-sender.ts.
RESEND_API_KEY="TODO: client provides"
# The verified sending address once a domain is set up in Resend — must be
# on a domain whose SPF/DKIM records are verified there (see
# docs/deployment/EMAIL_SETUP.md). Not itself a secret; safe as a real value.
RESEND_FROM_EMAIL="TripNexio <no-reply@tripnexio.com>"

# WhatsApp Cloud API (src/lib/whatsapp/) — TODO: client provides real values
# from Meta Business Manager > WhatsApp > API Setup: a permanent access
# token (System User token, not the 24h test token), the Phone Number ID
# shown there, and the App Secret from the Meta App's Basic Settings. See
# docs/deployment/WHATSAPP_SETUP.md for the full walkthrough. Until all
# three are filled in, the app logs to the console instead of calling the
# real Cloud API — see src/lib/whatsapp/get-gateway.ts.
WHATSAPP_ACCESS_TOKEN="TODO: client provides"
WHATSAPP_PHONE_NUMBER_ID="TODO: client provides"
WHATSAPP_APP_SECRET="TODO: client provides"
# We invent this one ourselves (not from Meta) and paste the exact same
# value into Meta's webhook-configuration screen when registering the
# webhook URL. Generate a fresh one per environment, e.g.
# `node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"`.
WHATSAPP_WEBHOOK_VERIFY_TOKEN="replace-with-a-random-verify-token"

# Anthropic (Claude) — powers the WhatsApp bot's natural-language intent
# detection and FAQ-only answering (src/lib/whatsapp-bot/), and passport
# OCR/MRZ extraction (src/lib/ocr/). Get a key from
# https://console.anthropic.com. Until filled in, the bot falls back to
# rule-based keyword matching and OCR falls back to a sample result — see
# get-ai-provider.ts / get-provider.ts in each folder.
ANTHROPIC_API_KEY="TODO: client provides"
# Google Gemini — passport/ticket/visa OCR (src/lib/ocr/gemini-ocr-provider.ts).
# When set, OCR uses Gemini instead of Claude; the WhatsApp bot and Ask AI
# still use ANTHROPIC_API_KEY (or their keyword fallback). Get a key at
# https://aistudio.google.com/apikey. GEMINI_OCR_MODEL is optional (default
# gemini-3-flash-preview); set e.g. "gemini-2.5-flash" if a preview model is retired.
GEMINI_API_KEY="TODO: client provides"
GEMINI_OCR_MODEL=""

# n8n automation (src/lib/automation/, see AUTOMATION_WORKFLOWS.md and
# docs/deployment/N8N_SETUP.md) — a shared secret WE generate, not a
# third-party credential. Paste the exact same value into an n8n "HTTP
# Header Auth" credential (header name "Authorization", value
# "Bearer <this value>") and select it on every HTTP Request node that
# calls this app. Generate one with:
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Until this is set, every /api/automation/* route rejects all requests.
AUTOMATION_API_KEY="replace-with-a-random-automation-key"

# Vercel Cron (vercel.json "crons") — an alternative scheduler to n8n. Once
# this is set in the Vercel project's Environment Variables, Vercel sends
# `Authorization: Bearer <CRON_SECRET>` on every scheduled GET to
# /api/automation/*; the app accepts either this or AUTOMATION_API_KEY
# (both constant-time compared). Leave empty/"TODO..." to disable Vercel
# Cron auth (safe-closed). Generate it the same way as AUTOMATION_API_KEY.
# Note: Vercel Hobby only runs each cron job at most once a day — the
# sub-daily schedules in vercel.json need Vercel Pro (or keep n8n/VPS cron).
CRON_SECRET="TODO: generate a random secret"

# Password for the initial staff account (admin@tripnexio.com) created by
# `npm run db:seed`. Required by the seed (at least 12 characters); never
# committed and never printed. Only used when that account does not exist yet.
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"

# P09 — Google Sign-In for customers and staff (optional). Leave as TODO to hide the buttons.
# Authorised redirect URI in Google Cloud: <site url>/api/auth/google/callback
GOOGLE_CLIENT_ID="TODO: client provides"
GOOGLE_CLIENT_SECRET="TODO: client provides"
