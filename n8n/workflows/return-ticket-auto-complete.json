{
  "name": "TripNexio - Return Ticket Auto-complete After Travel",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "c7e1a2b3-5678-4c9d-8e0f-1a2b3c4d5e6f",
      "name": "Daily at 6:00 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "notes": "Set this n8n instance's timezone to Asia/Kolkata so this actually fires at 6:00 AM IST."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRIPNEXIO_BASE_URL }}/api/automation/return-ticket-auto-complete",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "d8f2b3c4-6789-4dae-9f10-2b3c4d5e6f70",
      "name": "Call Return Ticket Auto-complete API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [280, 0],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "TripNexio Automation Key"
        }
      }
    }
  ],
  "connections": {
    "Daily at 6:00 AM": {
      "main": [[{ "node": "Call Return Ticket Auto-complete API", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
