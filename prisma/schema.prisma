// TripNexio — Prisma schema (M2)
//
// Conventions used throughout this file:
// - Every status/lifecycle field is a Prisma enum (hard requirement).
// - Every foreign-key scalar and every status/boolean-flag field used for
//   filtering has an explicit @@index — Prisma does not auto-index FK
//   columns on PostgreSQL the way it does on MySQL.
// - Monetary values use Decimal(10,2), never Float.
// - IDs are cuid() — no DB extension required (vs. Postgres gen_random_uuid()).
// - Fields marked "computed" (Quotation.margin, Refund.refundAmount) are
//   plain stored columns; the API layer computes and writes them, they are
//   not DB generated/computed columns. Keeping them as real columns (rather
//   than deriving them on every read) matches this schema's audit/reporting
//   needs — a margin or refund amount must stay stable and queryable even if
//   the inputs it was computed from are edited later.
// - No real domain data (airports/airlines/borders/prices) is seeded here —
//   see prisma/seed.ts, which only inserts clearly-labeled "Sample ..." rows
//   plus the RBAC bootstrap rows genuinely needed to run the app.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ServiceType {
  NEW_VISA
  VISA_EXTENSION
  VISA_CHANGE
  FLIGHT_SPECIAL_FARE
  RETURN_TICKET
  OTB
}

/// Proposed default lead lifecycle — CLAUDE.md only specified "status enum"
/// for Lead without exact values; review/adjust before relying on these.
enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  CONVERTED
  ON_HOLD
  LOST
}

/// CRM.md §5, locked: "Lead temperature: Cold, Warm, Hot." Step 12
/// (client-locked-spec roadmap, audit §3.1). Nullable on Lead — no natural
/// default at intake (a customer/WhatsApp submission carries no signal for
/// this), so a lead has no temperature until staff explicitly classifies
/// it; "settable by staff" in the roadmap prompt reads as an explicit
/// action, not an auto-assigned default.
enum LeadTemperature {
  COLD
  WARM
  HOT
}

/// Proposed default booking lifecycle — same caveat as LeadStatus.
enum BookingStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

/// Proposed default refund lifecycle — same caveat as LeadStatus.
enum RefundStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum DocumentStatus {
  REQUIRED
  MISSING
  RECEIVED
  VERIFIED
  REJECTED
}

/// INFANT added Step 9 (client-locked-spec roadmap): Flight_Special_Fare.md
/// §7/§12 locks Adult(12+)/Child(2-11)/Infant(<2) passenger typing, computed
/// from DOB on travel date, and Quotation.infantFare already existed as a
/// quote field with nowhere to record an actual infant passenger — this
/// closes that gap (AUDIT_REPORT.md §2.4, flagged CONFLICTING).
enum PaxType {
  ADULT
  CHILD
  INFANT
}

/// Return_Verified_Ticket.md §5/§6, locked (Step 10, client-locked-spec
/// roadmap): the customer selects only a visa type (30 or 60 days) and a
/// travel date — the return/onward date is server-computed from this, never
/// customer-entered. AUDIT_REPORT.md flagged the pre-Step-10 schema/route as
/// not confirmed to implement this (it accepted returnDate as free input).
enum ReturnTicketVisaType {
  THIRTY_DAYS
  SIXTY_DAYS
}

// GccCountry enum removed (Step 6.1, client-locked-spec roadmap) — Airport/
// Border's country classification is now the admin-managed Country model
// below, so a new country can be added without a Prisma migration.

// ---------------------------------------------------------------------------
// Customer 360
// ---------------------------------------------------------------------------

model Customer {
  id           String   @id @default(cuid())
  name         String
  mobile       String   @unique
  email        String?  @unique
  /// Set only once a customer actually registers/logs in — a guest's
  /// Customer row (created by findOrCreateCustomer at lead-submission time,
  /// see src/lib/leads/create-lead.ts) has no password until they later
  /// register with the same mobile/email, at which point registration
  /// claims that existing row instead of creating a duplicate.
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  passengers Passenger[]
  leads      Lead[]
  bookings   Booking[]
}

model Passenger {
  id               String    @id @default(cuid())
  customerId       String
  fullName         String
  passportNumber   String?
  dob              DateTime?
  nationality      String?
  paxType          PaxType
  passportFrontUrl String?
  passportBackUrl  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  customer        Customer             @relation(fields: [customerId], references: [id])
  documents       Document[]
  extractions     DocumentExtraction[]
  bookingLinks    BookingPassenger[]
  tasks           Task[]
  protectionPlans ProtectionPlan[]

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Lead → Quotation → Booking → Payment → Refund
// ---------------------------------------------------------------------------

model Lead {
  id              String           @id @default(cuid())
  customerId      String
  serviceType     ServiceType
  source          String?
  status          LeadStatus       @default(NEW)
  /// Unguessable token for the guest customer review page (/quote/<token>):
  /// see staff-prepared quotation(s), approve one, then pay — same pattern as
  /// Booking.customerToken for the pay-right-after-the-form services. Set at
  /// creation for the services that go through a staff quotation (New Visa,
  /// Visa Extension, Visa Change, Flight Special Fare); null for OTB/Return
  /// Ticket, which skip straight to a Booking.customerToken instead.
  customerToken   String?          @unique
  /// Step 19 (audit §3.9/§7.3) — the per-service-configurable granular
  /// status layered ON TOP OF `status` above, not replacing it. `status`
  /// stays the coarse sales-pipeline signal every existing consumer
  /// (dashboard KPIs, lead-followup automation, the WhatsApp bot) already
  /// reads; this optional FK is where a future service-specific Lead-level
  /// status control would attach, once/if one is built — see
  /// ServiceStatus's own doc comment for why the granular case-processing
  /// detail this step is really about lives at the Booking level instead.
  serviceStatusId String?
  /// CRM.md §5 (Step 12) — staff-set, no default; see the enum's own doc comment.
  temperature     LeadTemperature?
  assignedStaffId String?
  /// Service-specific captured fields (e.g. destination country + visa type
  /// for NEW_VISA, entry date for VISA_EXTENSION, Airport-to-Airport vs
  /// Border Exit choice + selected option for VISA_CHANGE). Shape varies by
  /// serviceType — validated at the API layer, not by the DB.
  details         Json
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  assignedStaff User?          @relation(fields: [assignedStaffId], references: [id])
  serviceStatus ServiceStatus? @relation(fields: [serviceStatusId], references: [id])
  quotations    Quotation[]
  bookings      Booking[]
  tasks         Task[]

  @@index([customerId])
  @@index([serviceType])
  @@index([status])
  @@index([temperature])
  @@index([assignedStaffId])
  @@index([serviceStatusId])
}

model Quotation {
  id                String    @id @default(cuid())
  leadId            String
  /// --- Flight Special Fare fields (structured quote) ---
  airline           String?
  flightNumber      String?
  route             String?
  /// Departure date/time for a flight quote.
  flightDateTime    DateTime?
  arrivalDateTime   DateTime?
  baggageAllowance  String?
  fareType          String?
  adultFare         Decimal?  @db.Decimal(10, 2)
  childFare         Decimal?  @db.Decimal(10, 2)
  infantFare        Decimal?  @db.Decimal(10, 2)
  /// Visa Change itinerary options: the flight-ticket component of one itinerary, added on top of feeAmount + fineOrCharges.
  flightTicketPrice Decimal?  @db.Decimal(10, 2)
  /// --- Visa services / OTB fields (simple fee-based quote) ---
  feeAmount         Decimal?  @db.Decimal(10, 2)
  fineOrCharges     Decimal?  @db.Decimal(10, 2)
  /// --- Commercial fields shared by every service type ---
  vendorId          String
  vendorCost        Decimal   @db.Decimal(10, 2)
  /// The customer-facing total. For Flight Special Fare this is staff-entered
  /// directly; for every other service type the API computes it server-side
  /// as feeAmount + fineOrCharges. Never shown to the customer alongside
  /// vendorCost/margin — those two stay staff-only.
  sellingPrice      Decimal   @db.Decimal(10, 2)
  /// Computed by the API layer as sellingPrice - vendorCost on write.
  margin            Decimal   @db.Decimal(10, 2)
  /// --- Step 22 (audit §3.2/§4.2/§7.8) — CRM.md §10's pricing formula ---
  /// Never set for a Flight Special Fare quote — §10 gives flight its own
  /// formula ("Selling Amount + Configured Gateway Charge = Customer
  /// Payable") with no coupon term at all. `couponDiscount` is a snapshot
  /// computed once when the code is applied (src/lib/coupons/apply.ts),
  /// not recalculated later — same config-snapshot precedent as `margin`
  /// and `sellingPrice` itself, so an Admin editing the coupon afterward
  /// doesn't retroactively change an already-quoted discount.
  couponId          String?
  couponCode        String?
  couponDiscount    Decimal?  @db.Decimal(10, 2)
  validityExpiresAt DateTime?
  isSelected        Boolean   @default(false)
  isExpired         Boolean   @default(false)
  /// Set when this quote represents an alternative route/option offered
  /// instead of what the customer originally requested — points at the
  /// sibling quotation (on the same lead) it stands in for. The UI must
  /// always render this quotation's own `route`, never the requested one.
  alternativeOfId   String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lead          Lead        @relation(fields: [leadId], references: [id])
  vendor        Vendor      @relation(fields: [vendorId], references: [id])
  coupon        Coupon?     @relation(fields: [couponId], references: [id])
  alternativeOf Quotation?  @relation("QuotationAlternatives", fields: [alternativeOfId], references: [id])
  alternatives  Quotation[] @relation("QuotationAlternatives")

  @@index([leadId])
  @@index([vendorId])
  @@index([couponId])
  @@index([alternativeOfId])
  @@index([isSelected])
  @@index([isExpired])
}

model Booking {
  id                        String            @id @default(cuid())
  /// Formatted like TNX-XX-XXXXXX (XX = a service-type short code, e.g. NV,
  /// OT, VE) — generated by the API layer, not the DB, since the format
  /// depends on the lead's serviceType.
  bookingId                 String            @unique
  /// Random, unguessable token for the guest customer pages (/pay/<token>):
  /// pay, then upload documents after payment. Only set for bookings created
  /// by the website's pay-right-after-the-form flow (Return Ticket, OTB).
  customerToken             String?           @unique
  leadId                    String
  customerId                String
  status                    BookingStatus     @default(PENDING)
  /// Return_Verified_Ticket.md §7, locked (Step 10): "Reservation can be
  /// issued up to 24 hours before travel. Once issued, the reservation is
  /// intended to be valid for the next 24 hours... CRM should store issue
  /// time and expected expiry time." Nullable/meaningful only for
  /// RETURN_TICKET bookings — same nullable-per-service-shape pattern
  /// already used on Quotation for its flight-only columns. Set together by
  /// PATCH /api/bookings/[id]/issue-reservation; reservationExpired is
  /// lazily flipped by syncExpiredReservations() on read, mirroring
  /// Quotation.isExpired/syncExpiredQuotations().
  reservationIssuedAt       DateTime?
  reservationExpiresAt      DateTime?
  reservationExpired        Boolean           @default(false)
  /// Visa_Extension.md §17/§18, locked (Step 15, audit §7.4): "Not Accepted"
  /// (sponsor/authority didn't accept the extension — refund minus gateway)
  /// and "Rejected" (formal rejection — no refund) are explicitly separate
  /// CRM statuses with different refund treatment, which the generic
  /// `BookingStatus`/`RefundStatus` enums have no way to represent — this is
  /// the schema addition the roadmap prompt calls for. Nullable/meaningful
  /// only for VISA_EXTENSION bookings, same nullable-per-service-shape
  /// pattern as the reservation fields above. Set via
  /// PATCH /api/bookings/[id]/extension-outcome, which also moves
  /// Booking.status to CANCELLED (neither outcome is a successful
  /// completion) — see src/lib/refunds/rules.ts for how this drives the
  /// refund rule engine.
  extensionOutcome          ExtensionOutcome?
  /// Step 19 (audit §3.9/§7.3) — the per-service, Admin-configured granular
  /// operational status (CRM.md §14: "every service has its own status
  /// workflow"). `status` above is deliberately KEPT as the coarse
  /// system-level lifecycle every existing consumer already reads (the
  /// refund rule engine's blocksRefund check, the Task Engine, Command
  /// Centre KPIs, payment-success flow) — this FK is the new layer staff
  /// actually pick from in the Change Status modal; setting it cascades an
  /// update to `status` via ServiceStatus.mapsToBookingStatus, so none of
  /// those existing consumers need to change. See ServiceStatus's own
  /// schema comment for the full design rationale.
  serviceStatusId           String?
  /// Step 23 (audit §7.6) — ADMIN.md §19/§40/§46(#11): admin config changes
  /// apply immediately to new work, but a paid booking must retain what it
  /// was created against. Pricing/GST already behave this way by accident
  /// (stored computed-once columns, never re-read live) — this is the same
  /// treatment made explicit for the document checklist, which until now
  /// had no equivalent (`DocumentRequirement` is a live, current-state
  /// table). Written once at booking creation (POST /api/bookings) from the
  /// then-current active DocumentRequirement rows, resolved per this
  /// booking's own passengers via each one's `Passenger.nationality` —
  /// there's no single "the booking's nationality" in this schema, only a
  /// per-passenger one, so the snapshot is grouped that way too. Null for
  /// any booking created before this field existed (no backfill — there's
  /// no way to know what config applied at that booking's own creation time
  /// after the fact) and for any passenger with no nationality on file. See
  /// src/lib/bookings/document-checklist-snapshot.ts for the shape.
  documentChecklistSnapshot Json?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  lead            Lead                 @relation(fields: [leadId], references: [id])
  customer        Customer             @relation(fields: [customerId], references: [id])
  serviceStatus   ServiceStatus?       @relation(fields: [serviceStatusId], references: [id])
  payments        Payment[]
  documents       Document[]
  passengers      BookingPassenger[]
  extractions     DocumentExtraction[]
  tasks           Task[]
  protectionPlans ProtectionPlan[]

  @@index([leadId])
  @@index([customerId])
  @@index([serviceStatusId])
  @@index([status])
}

enum ExtensionOutcome {
  NOT_ACCEPTED
  REJECTED
}

/// CRM.md §12, locked (Step 14, audit §3.3): "Each PAX must be
/// independently visible... Do not force all PAX into one combined status
/// where individual processing is required." Establishes the first-ever
/// direct Booking<->Passenger link — until now, "which passengers belong to
/// this booking" only existed indirectly via the parent Lead's
/// `details.passengerIds` JSON array (see create-lead.ts), which Document
/// already relies on for its own optional `passengerId`. One row created
/// per Lead.details.passengerIds entry when a Booking is created
/// (POST /api/bookings) — see that route.
///
/// `status` reuses BookingStatus rather than a new bespoke enum, so
/// Booking.status can genuinely stay "the aggregate/rollup view" the
/// roadmap prompt asks for (same vocabulary, finer grain) instead of two
/// unrelated status systems. CRM.md §14 separately describes a much larger,
/// fully Admin-configurable per-service status list ("Every service has its
/// own status workflow... only statuses configured by Admin... available")
/// — that is a distinct, unbuilt feature (its own future roadmap step), not
/// what this reuses or replaces.
model BookingPassenger {
  id          String        @id @default(cuid())
  bookingId   String
  passengerId String
  status      BookingStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  booking   Booking   @relation(fields: [bookingId], references: [id])
  passenger Passenger @relation(fields: [passengerId], references: [id])

  @@unique([bookingId, passengerId])
  @@index([bookingId])
  @@index([passengerId])
  @@index([status])
}

model Payment {
  id             String        @id @default(cuid())
  bookingId      String
  /// The pre-discount base fare — GST/gatewayFee below are computed on
  /// `amount - couponDiscount`, not on `amount` itself (Step 22, audit
  /// §7.8), so the original figure stays visible on the invoice as its own
  /// line even after a coupon is applied.
  amount         Decimal       @db.Decimal(10, 2)
  gstAmount      Decimal       @db.Decimal(10, 2)
  gatewayFee     Decimal       @db.Decimal(10, 2)
  /// Snapshotted from the selected Quotation at payment-creation time — see
  /// Quotation.couponDiscount's own doc comment for the config-snapshot
  /// rationale. `couponId` is what src/lib/payments/complete-payment.ts
  /// increments Coupon.usageCount against, once, only on the real
  /// PENDING -> SUCCESS transition (never on quote creation — a quote can
  /// expire unused).
  couponId       String?
  couponCode     String?
  couponDiscount Decimal?      @db.Decimal(10, 2)
  status         PaymentStatus @default(PENDING)
  /// The gateway's own id for this payment link/order — how an incoming
  /// webhook is matched back to this row. Unique (Postgres allows multiple
  /// NULLs under a unique constraint, so this is safe before a payment
  /// link has been generated).
  gatewayRef     String?       @unique
  paymentLink    String?
  linkExpiresAt  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  booking Booking  @relation(fields: [bookingId], references: [id])
  coupon  Coupon?  @relation(fields: [couponId], references: [id])
  refunds Refund[]

  @@index([bookingId])
  @@index([couponId])
  @@index([status])
}

model Refund {
  id                 String       @id @default(cuid())
  paymentId          String
  paidAmount         Decimal      @db.Decimal(10, 2)
  cancellationCharge Decimal      @db.Decimal(10, 2)
  gatewayCharge      Decimal      @db.Decimal(10, 2)
  /// Computed by the API layer as paidAmount - cancellationCharge - gatewayCharge on write.
  refundAmount       Decimal      @db.Decimal(10, 2)
  reason             String?
  /// CRM.md §21, locked (Step 14, audit §3.5, CONFLICTING): "Refunds
  /// require... Passenger selection where partial passenger refund
  /// applies." Empty (the default) = applies to the whole booking/payment,
  /// same as every refund before this step. A plain Passenger.id array, not
  /// a join table — there's no per-refund metadata beyond "which
  /// passengers" to justify one. Judgment call: `refundAmount` itself is
  /// still computed the existing way (paidAmount - charges, staff-entered
  /// figures) — §21 also says "Calculate eligible refund based on
  /// configured passenger allocation/charges", but no per-passenger price
  /// breakdown exists anywhere in this schema (Quotation.sellingPrice is
  /// one total for the whole booking) to compute an automatic split from.
  /// Inventing one (e.g. an even split by passenger count) would be exactly
  /// the kind of fabricated business rule CRM.md §21 itself warns against
  /// for the adjacent "Generic non-passenger partial refund" case ("Keep as
  /// OPEN QUESTION. Do not invent a calculation formula") — the same
  /// caution applies here. Passenger selection is real and stored; the
  /// amount stays staff-entered until real per-passenger pricing exists.
  passengerIds       String[]     @default([])
  status             RefundStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([status])
}

model Document {
  id          String         @id @default(cuid())
  passengerId String?
  bookingId   String?
  /// e.g. "PASSPORT", "VISA_COPY", "TICKET" — free text since the set of
  /// document types varies per service; see DocumentRequirement for the
  /// per-nationality master list this is checked against.
  type        String
  status      DocumentStatus @default(REQUIRED)
  fileUrl     String?
  /// Step 21 (audit §7.5) — New_Visa.md §27: set when the retention-purge
  /// automation deletes this document's file (3+ months past the
  /// booking's processing completion, Passport/Visa types exempted). The
  /// row itself is kept (so Customer/Booking history still shows a
  /// document of this type existed) — only `fileUrl` is cleared. Also set
  /// by the same purge path when staff replace a file (§18: "old file is
  /// deleted") — see PATCH /api/documents/[id]/upload and
  /// POST /api/passengers/[id]/passport-photo, though those clear this on
  /// the *superseded* row, not the new one.
  purgedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  passenger Passenger? @relation(fields: [passengerId], references: [id])
  booking   Booking?   @relation(fields: [bookingId], references: [id])

  extractions DocumentExtraction[]

  @@index([passengerId])
  @@index([bookingId])
  @@index([status])
}

enum OcrExtractionStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
}

/// Step 16 (client-locked-spec roadmap, audit §3.6): CRM.md §17 (Ticket OCR)
/// and §18 (Visa OCR) extend the OCR pipeline this app already had for
/// passports (Phase 5D) to two more document types. Generalized from the
/// old passport-only `PassportExtraction` model into one shared model with
/// an `extractionType` discriminator, per the roadmap prompt's own
/// preference ("rather than bolting this onto the passport-specific
/// model") — the three types share the same review/confirm-or-reject
/// lifecycle, just different field shapes and confirm targets.
///
/// `passengerId`/`bookingId` are both optional (a passport extraction
/// always has a passengerId, matching Document's own passport requirement;
/// a ticket/visa extraction may be tied to a specific passenger, a booking
/// generally, or both, mirroring Document's own optionality).
///
/// Confirm targets differ by type — see PATCH /api/document-extractions/[id]:
/// - PASSPORT: applies the reviewed fields onto the Passenger row (unchanged
///   behavior from the old PassportExtraction model).
/// - TICKET/VISA: there is no dedicated Ticket/Visa entity in this schema to
///   write structured fields onto (CRM.md's own document is a functional
///   reference, not a literal schema spec) — inventing new Booking columns
///   for this would be exactly the kind of unscoped addition CLAUDE.md's
///   hard rules warn against. "Ticket data is stored against the booking"
///   (§17) is satisfied by the extraction row itself: it's already linked
///   to the booking via `document.bookingId`, and once CONFIRMED, its
///   (possibly staff-edited) `extractedFields` IS the permanent, verified
///   record — displayed on the Booking detail page. Confirming just moves
///   status to CONFIRMED with the final edited fields; no other row changes.
model DocumentExtraction {
  id               String                 @id @default(cuid())
  documentId       String
  passengerId      String?
  bookingId        String?
  extractionType   DocumentExtractionType
  /// Which OcrProvider implementation produced this (e.g. "claude",
  /// "placeholder (no ANTHROPIC_API_KEY configured)") — surfaced in the
  /// review UI so staff can see when a result is a dev-only sample, not a
  /// real reading of the uploaded document.
  provider         String
  status           OcrExtractionStatus    @default(PENDING_REVIEW)
  /// Shape depends on extractionType — PassportOcrFields, TicketOcrFields,
  /// or VisaOcrFields (src/lib/ocr/types.ts) — whatever the provider could
  /// read, staff-editable before confirming.
  extractedFields  Json
  /// Passport-only — the raw two-line MRZ text as read from the image, when
  /// found, kept for staff to visually cross-check. Always null for
  /// TICKET/VISA (no MRZ on those document types).
  mrzRaw           String?
  mrzValid         Boolean                @default(false)
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  document   Document   @relation(fields: [documentId], references: [id])
  passenger  Passenger? @relation(fields: [passengerId], references: [id])
  booking    Booking?   @relation(fields: [bookingId], references: [id])
  reviewedBy User?      @relation(fields: [reviewedByUserId], references: [id])

  @@index([documentId])
  @@index([passengerId])
  @@index([bookingId])
  @@index([status])
  @@index([extractionType])
}

enum DocumentExtractionType {
  PASSPORT
  TICKET
  VISA
}

// ---------------------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------------------

model AuditTrail {
  id         String   @id @default(cuid())
  /// Polymorphic reference — e.g. entityType "Booking", entityId the
  /// Booking's cuid. Not a real FK since it can point at any table.
  entityType String
  entityId   String
  action     String
  byUserId   String?
  timestamp  DateTime @default(now())
  note       String?

  byUser User? @relation(fields: [byUserId], references: [id])

  @@index([entityType, entityId])
  @@index([byUserId])
  @@index([timestamp])
}

// ---------------------------------------------------------------------------
// Per-Service Status Engine (Step 19, audit §3.9/§7.3) — Unit 1 of the
// roadmap's proposed multi-unit breakdown: schema + Admin CRUD only, no
// Lead/Booking control wiring yet (that's Units 2-3).
//
// CRM.md §14, locked: "Every service has its own status workflow. CRM must
// never use one universal status list for all services." The pre-existing
// LeadStatus/BookingStatus enums are exactly that universal list the rule
// forbids — but they're also load-bearing for a dozen+ other subsystems
// that only care about the coarse lifecycle stage, not per-service detail:
// the refund rule engine's hard-block check (src/lib/refunds/rules.ts,
// keyed on BookingStatus.PROCESSING), the Task Engine, Command Centre KPIs,
// lead-followup automation, and the payment-success flow (Booking ->
// CONFIRMED, Lead -> CONVERTED). Rewriting all of those to read a free-form
// Admin-configurable status table in one shot would be the "one giant
// migration" the roadmap prompt explicitly said not to do.
//
// The design instead LAYERS ServiceStatus on top of the existing enums
// rather than replacing them: `mapsToBookingStatus`/`mapsToLeadStatus`
// lets each granular status declare which coarse enum value it corresponds
// to, so setting a Lead/Booking's serviceStatusId can cascade-update the
// existing `status` column — every existing consumer keeps reading the
// coarse enum unmodified, while staff's actual Change Status control
// (Units 2-3) offers the real per-service list CRM.md asks for.
//
// `blocksRefund` generalizes the refund engine's hard-coded
// "BookingStatus.PROCESSING means sent to an external party" interpretation
// (Step 15) into admin-configurable per-status data — Unit 3 wires
// src/lib/refunds/rules.ts to also honor this flag once real Bookings
// start carrying a serviceStatusId.
//
// `customerLabel` is the CRM.md §14 "customer-safe status" mapping,
// deliberately a plain nullable column rather than a separate join table —
// it's a strict one-to-one per status, not a many-to-one the client's docs
// ever describe. Left null almost everywhere on purpose: ADMIN.md §45 #6
// explicitly lists "final customer-safe status mapping" as an OPEN ITEM,
// not something to invent; seeded only where CRM.md itself gives a literal
// example (New Visa's "Applied to Embassy" -> "Application submitted for
// processing").
//
// Every ServiceStatus row below is seeded from a service MD's own already-
// locked, named status list (New_Visa.md §10, OTB.md §18, Visa_Change.md
// §25, Visa_Extension.md §19, Return_Verified_Ticket.md §24,
// Flight_Special_Fare.md §23) — real client-authored content, not invented
// SAMPLE data (CLAUDE.md hard rule #1). All seeded at `scope: BOOKING`: the
// granular case-processing detail every one of those lists describes is
// booking-level work (BookingStatus is already the richer of the two
// coarse enums for exactly this reason); LeadStatus's simpler sales-funnel
// stages have no distinct per-service breakdown anywhere in the client's
// docs, so `scope: LEAD` stays available in the schema for symmetry/future
// use but is intentionally not seeded or wired to a control in this step.
// ---------------------------------------------------------------------------

enum StatusScope {
  LEAD
  BOOKING
}

model ServiceStatus {
  id                  String         @id @default(cuid())
  serviceType         ServiceType
  scope               StatusScope
  /// Internal/operational name, e.g. "Applied to Embassy" — exactly as
  /// named in the service's own locked MD.
  name                String
  /// Optional UI grouping label — only OTB.md's own spec groups its
  /// statuses into named clusters (Booking/Verification/Airline/
  /// Exceptions); null for every other service's flat list.
  group               String?
  displayOrder        Int            @default(0)
  isTerminal          Boolean        @default(false)
  /// See module comment — generalizes the refund engine's hard-coded
  /// "sent to an external party" cutoff into per-status admin-configured data.
  blocksRefund        Boolean        @default(false)
  /// CRM.md §14's "customer-safe status" — see module comment for why this
  /// stays null almost everywhere for now.
  customerLabel       String?
  /// See module comment — only one of these two is meaningful per row,
  /// matching `scope`; not enforced at the DB level, validated at the API layer.
  mapsToLeadStatus    LeadStatus?
  mapsToBookingStatus BookingStatus?
  active              Boolean        @default(true)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  leads           Lead[]
  bookings        Booking[]
  fromTransitions ServiceStatusTransition[] @relation("FromStatus")
  toTransitions   ServiceStatusTransition[] @relation("ToStatus")

  @@unique([serviceType, scope, name])
  @@index([serviceType, scope])
}

/// Admin-editable transition matrix replacing the hard-coded transition
/// maps in src/lib/leads/transitions.ts / src/lib/bookings/transitions.ts
/// for whichever service+scope has been migrated onto ServiceStatus —
/// ADMIN.md §17: "Admin configures: available statuses, status
/// transitions, workflow order... per service/sub-service."
model ServiceStatusTransition {
  id           String @id @default(cuid())
  fromStatusId String
  toStatusId   String

  from ServiceStatus @relation("FromStatus", fields: [fromStatusId], references: [id])
  to   ServiceStatus @relation("ToStatus", fields: [toStatusId], references: [id])

  @@unique([fromStatusId, toStatusId])
  @@index([fromStatusId])
  @@index([toStatusId])
}

// ---------------------------------------------------------------------------
// Task Engine (Step 17, audit §3.8) — proposed default type/priority/status
// sets, same caveat as every other enum in this file: not explicitly
// specified beyond the per-service MDs' example task names, review before
// relying on them.
// ---------------------------------------------------------------------------

enum TaskType {
  DOCUMENT_COLLECTION
  MANUAL_VERIFICATION
  QUOTE_FOLLOW_UP
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id                String       @id @default(cuid())
  type              TaskType
  priority          TaskPriority @default(NORMAL)
  status            TaskStatus   @default(OPEN)
  title             String
  reason            String?
  /// Polymorphic link to whatever triggered this task — mirrors
  /// AuditTrail's own entityType/entityId pattern (e.g. entityType
  /// "Document", "DocumentExtraction", "Quotation") rather than a single
  /// dedicated FK, since not every trigger has a Booking yet (a quote
  /// about to expire has no Booking; a passenger-only passport document
  /// has no Booking either). leadId/bookingId/passengerId/serviceType
  /// below are denormalized display/filter convenience fields resolved
  /// once at creation time from whichever of them the trigger could
  /// derive — not every task can populate every one of them.
  entityType        String
  entityId          String
  leadId            String?
  bookingId         String?
  passengerId       String?
  serviceType       ServiceType?
  assignedToId      String?
  dueDate           DateTime?
  completedAt       DateTime?
  completedByUserId String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  lead        Lead?      @relation(fields: [leadId], references: [id])
  booking     Booking?   @relation(fields: [bookingId], references: [id])
  passenger   Passenger? @relation(fields: [passengerId], references: [id])
  assignedTo  User?      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  completedBy User?      @relation("TaskCompletedBy", fields: [completedByUserId], references: [id])

  @@index([entityType, entityId])
  @@index([status])
  @@index([assignedToId])
  @@index([leadId])
  @@index([bookingId])
  @@index([passengerId])
  @@index([dueDate])
}

// ---------------------------------------------------------------------------
// Vendor
// ---------------------------------------------------------------------------

/// §12 (Admin FINAL handover): one vendor can support multiple services/sub-services
/// without duplicate Vendor rows — service coverage lives on VendorService below.
/// Vendor cost/rate stays trackable service-wise through each Quotation's own
/// vendorCost (a Quotation is always scoped to its Lead's serviceType), not a field here.
model Vendor {
  id                String   @id @default(cuid())
  name              String
  mobile            String?
  email             String?
  pocName           String?
  processingDetails String?
  availability      String?
  gstNumber         String?
  paymentDetails    String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  services   VendorService[]
  quotations Quotation[]

  @@index([active])
}

/// Join table: which services/sub-services a Vendor is linked to (§12 "service coverage").
model VendorService {
  id        String      @id @default(cuid())
  vendorId  String
  service   ServiceType
  createdAt DateTime    @default(now())

  vendor Vendor @relation(fields: [vendorId], references: [id])

  @@unique([vendorId, service])
  @@index([service])
}

// ---------------------------------------------------------------------------
// Masters (admin-managed; see CLAUDE.md hard rule #1 — no real rows seeded)
// ---------------------------------------------------------------------------

/// Admin-editable presentation/metadata layer over the 6 locked services
/// (Step 6.2, client-locked-spec roadmap: client wants to edit existing
/// services' name/description/icon/order/on-off without a code deployment).
/// `code` matches the ServiceType enum's string values exactly and is
/// validated against it server-side (src/lib/validation/service-schema.ts)
/// -- this does NOT replace ServiceType, which stays the business-logic
/// type-safety enum across Lead/Quotation/Booking/DocumentRequirement/
/// PricingRule/Faq. A genuinely new (7th) service still needs a developer
/// to build its request flow/schema/route; once built, its metadata
/// registers here instead of needing a Prisma enum migration.
model Service {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  shortDescription String
  iconName         String
  active           Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([active])
}

/// Fully admin-manageable — replaces the old fixed GccCountry enum (Step 6.1,
/// client-locked-spec roadmap: client wants to add/edit countries without a
/// code deployment). `code` keeps the same identifiers the old enum used
/// (INDIA, UAE, SAUDI_ARABIA, ...) for continuity with existing data/labels,
/// but is now a plain unique string, not a fixed enum — a new one is just a
/// new row.
model Country {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  airports                Airport[]
  borders                 Border[]
  returnTicketDestination ReturnTicketDestination?
  newVisaPricing          NewVisaPricing[]

  @@index([active])
}

model Airport {
  id                String   @id @default(cuid())
  name              String
  code              String   @unique
  country           String
  city              String
  countryId         String
  activeForA2AEntry Boolean  @default(true)
  activeForA2AExit  Boolean  @default(true)
  displayOrder      Int      @default(0)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  countryRef Country @relation(fields: [countryId], references: [id])

  @@index([countryId])
  @@index([active])
}

model Airline {
  id                     String   @id @default(cuid())
  name                   String
  code                   String   @unique
  country                String
  otbRequired            Boolean  @default(false)
  normalPrice            Decimal? @db.Decimal(10, 2)
  urgentPrice            Decimal? @db.Decimal(10, 2)
  /// Per-airline OTB processing timelines; null = use the global
  /// OtbRuleConfig value (client: "process time as per airlines, Admin can
  /// configure"). standardProcessingDays is in WORKING DAYS;
  /// urgentProcessingHours is in WORKING HOURS (client answer, 2026-09-23:
  /// "Urgent OTB processing time: 8 working hours") — deliberately a
  /// different unit, not a smaller day count.
  standardProcessingDays Int?
  urgentProcessingHours  Int?
  displayOrder           Int      @default(0)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([otbRequired])
  @@index([active])
}

model Border {
  id                  String   @id @default(cuid())
  name                String
  /// The non-UAE country this crossing connects to.
  countryId           String
  uaeLocation         String
  destinationLocation String
  activeForVisaChange Boolean  @default(true)
  displayOrder        Int      @default(0)
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id])

  @@index([countryId])
  @@index([active])
}

/// Drives the customer document checklist per nationality per service —
/// e.g. a Nepali OTB applicant may need different documents than a Nepali
/// New Visa applicant, hence serviceType is part of the identity, not just
/// an optional filter.
model DocumentRequirement {
  id           String      @id @default(cuid())
  nationality  String
  serviceType  ServiceType
  documentName String
  required     Boolean     @default(true)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([nationality, serviceType, documentName])
  @@index([nationality])
  @@index([serviceType])
  @@index([active])
}

/// Reference pricing per service/pax-type, optionally overridden per
/// nationality where the spec requires it (nationality = null means the
/// rule applies to every nationality). This is a staff-facing reference
/// table, not an automated pricing engine — the quote builder still takes
/// staff-entered figures per quotation; wiring this in as a default/
/// suggestion is future work.
model PricingRule {
  id                String      @id @default(cuid())
  serviceType       ServiceType
  paxType           PaxType
  /// null = applies to all nationalities; a specific value overrides it.
  nationality       String?
  basePrice         Decimal     @db.Decimal(10, 2)
  additionalCharges Decimal     @default(0) @db.Decimal(10, 2)
  active            Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([serviceType])
  @@index([active])
}

enum CouponType {
  PERCENTAGE
  FIXED_AMOUNT
}

/// Step 22 (audit §3.2/§4.2/§7.8) — CRM.md §8's own three named categories
/// ("Employee coupon / External coupon where configured / Abandoned
/// quotation coupon"), a separate dimension from CouponType above (that's
/// the discount SHAPE — percentage vs. flat; this is who the coupon is
/// FOR). Existing rows backfill to EXTERNAL (the closest "normal" default)
/// on migration; new coupons must pick one explicitly.
enum CouponCategory {
  EMPLOYEE
  EXTERNAL
  ABANDONED_QUOTATION
}

model Coupon {
  id         String         @id @default(cuid())
  code       String         @unique
  type       CouponType
  /// A percentage (0-100) when type=PERCENTAGE, or a flat rupee amount when type=FIXED_AMOUNT.
  value      Decimal        @db.Decimal(10, 2)
  /// ADMIN.md §25 / CRM.md §8: "Support: Employee coupon, External coupon
  /// where configured, Abandoned quotation coupon." Only EMPLOYEE is
  /// actually enforced differently today (the ₹500 cap, see
  /// CouponConfig) — EXTERNAL/ABANDONED_QUOTATION exist as real,
  /// selectable categories for Admin's own reporting/organization, with no
  /// extra business rule layered on them yet since none is specified.
  category   CouponCategory @default(EXTERNAL)
  validFrom  DateTime
  validUntil DateTime
  /// null = unlimited uses.
  usageLimit Int?
  usageCount Int            @default(0)
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  quotations Quotation[]
  payments   Payment[]

  @@index([active])
  @@index([category])
}

/// True singleton (same pattern as TaxFeeConfig/ProtectionPlanConfig) —
/// ADMIN.md §25: "Current employee coupon limit: ₹500... This should be an
/// Admin configuration value, not permanent hard-coded logic." Applied as a
/// ceiling on the actual DISCOUNT AMOUNT an EMPLOYEE-category coupon can
/// apply (src/lib/coupons/apply.ts), not a cap on the coupon's own face
/// value — a percentage-type Employee coupon could otherwise compute a
/// discount over the cap depending on the quote total.
model CouponConfig {
  id                String   @id
  employeeCouponCap Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// Step 28 (audit §4.8) — ADMIN.md §28: "Expense categories should use
/// Admin-managed dropdown options... Admin can later add/disable/reorder
/// categories." The 16 "Initial examples" ADMIN.md itself names verbatim
/// (Advertising, Salary, Domain, VPS/Hosting, AI, API, WhatsApp, Email,
/// Software, OCR, Payment Gateway, Vendor, Office, Marketing, Operations,
/// Other) are seeded for real (not "Sample ..." placeholders) — these are
/// the client's own locked starting list, not invented data, same
/// treatment Step 19 gave the locked per-service status lists.
model ExpenseCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  expenses Expense[]

  @@index([active])
}

/// Step 28 (audit §4.8) — ADMIN.md §28's expense entries, feeding the P&L
/// report (§29). `date` (the expense's own date, @db.Date — no
/// time-of-day component, matching StaffLeave's precedent) is distinct
/// from `createdAt` (when the record was entered) — a staff member
/// logging last week's hosting invoice today shouldn't have it counted
/// against today's P&L period.
model Expense {
  id           String   @id @default(cuid())
  categoryId   String
  amount       Decimal  @db.Decimal(10, 2)
  date         DateTime @db.Date
  note         String?
  recordedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  recordedBy User            @relation(fields: [recordedById], references: [id])

  @@index([categoryId])
  @@index([date])
  @@index([recordedById])
}

/// The single knowledge base used by the website, the CRM, and later the
/// WhatsApp AI (see CLAUDE.md's Modules). `active` is a hard on/off switch
/// (an inactive FAQ is retired but not deleted); `published` is separate —
/// an active-but-unpublished FAQ is a draft staff can review before it goes
/// live on the website.
model Faq {
  id           String       @id @default(cuid())
  question     String
  answer       String
  /// null = not tied to one service (a general FAQ).
  serviceType  ServiceType?
  category     String?
  keywords     String[]
  displayOrder Int          @default(0)
  active       Boolean      @default(true)
  published    Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([serviceType])
  @@index([category])
  @@index([active])
  @@index([published])
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
}

/// Configurable copy for staff-triggered/system notifications — no
/// notification system actually sends anything yet (Phase 5, same as the
/// Document "FLAG_MISSING" flag above), so `event` is deliberately a free
/// string rather than a rigid enum: the real event catalog doesn't exist
/// yet either. `{{placeholder}}` variables in `body`/`subject` are a
/// convention for whatever Phase 5 substitution logic ends up doing —
/// nothing parses or validates them today.
model NotificationTemplate {
  id                   String              @id @default(cuid())
  event                String
  channel              NotificationChannel
  /// Email only — WhatsApp messages have no subject line.
  subject              String?
  body                 String
  active               Boolean             @default(true)
  /// WhatsApp only (Phase 5B/C). WhatsApp Cloud API can only send this
  /// template OUTSIDE an active 24h customer-initiated session as a
  /// Meta-approved Message Template, referenced by its exact approved name +
  /// language — never as raw free text. `body` above is still the source
  /// copy an admin edits and what gets submitted to Meta for approval; these
  /// two fields are filled in only once Meta has actually approved it (see
  /// docs/deployment/WHATSAPP_SETUP.md). Null/empty means "not yet approved
  /// by Meta" — the send is skipped (audited, not silently dropped) rather
  /// than guessed at.
  metaTemplateName     String?
  metaTemplateLanguage String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([event, channel])
  @@index([channel])
  @@index([active])
}

enum WhatsAppMessageDirection {
  INBOUND
  OUTBOUND
}

/// One row per WhatsApp number the bot has ever talked to — the
/// conversational state machine's persistence (Phase 5C). `state` is a free
/// string (not a locked enum), same rationale as LeadStatus/BookingStatus:
/// proposed default set, see src/lib/whatsapp-bot/engine.ts. `leadId` is a
/// plain cross-reference (no FK relation, same polymorphic-style pattern as
/// AuditTrail.entityId) since a conversation optionally produces at most one
/// Lead and nothing else needs to query "this Lead's conversation" yet.
model WhatsAppConversation {
  id              String       @id @default(cuid())
  waId            String       @unique
  customerName    String?
  state           String       @default("GREETING")
  serviceType     ServiceType?
  collectedFields Json         @default("{}")
  leadId          String?
  lastInboundAt   DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([state])
  @@index([leadId])
}

/// Full inbound/outbound transcript per WhatsApp number — separate from
/// AuditTrail (that model is state-change/event oriented, not meant for a
/// high-volume message transcript) and needed so a human handoff has the
/// actual conversation to pick up, not just "handoff happened."
model WhatsAppMessageLog {
  id           String                   @id @default(cuid())
  waId         String
  direction    WhatsAppMessageDirection
  body         String
  /// Step 18 (audit §3.7) — null for every bot-driven message (inbound
  /// customer messages and the bot's own automated replies, both written
  /// by the webhook route); set to the staff member's id only for a manual
  /// send from the CRM Communications screen, so the timeline can show
  /// "sent by {name}" vs. the automated conversation.
  sentByUserId String?
  createdAt    DateTime                 @default(now())

  sentByUser User? @relation(fields: [sentByUserId], references: [id])

  @@index([waId])
  @@index([createdAt])
}

/// A true singleton — exactly one row, fetched/updated by a fixed id (see
/// src/lib/settings/tax-fee-config.ts). Replaces the SAMPLE_GST_RATE/
/// SAMPLE_GATEWAY_FEE_RATE constants that used to be hard-coded in the
/// payment-creation route; every change writes an AuditTrail row so the
/// rate history isn't lost even though this table itself only holds the
/// current value.
model TaxFeeConfig {
  id                String   @id
  gstRatePercent    Decimal  @db.Decimal(5, 2)
  gatewayFeePercent Decimal  @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Protection Plan (Step 20, audit §7.1) — New_Visa.md §8-9, locked. A
// per-passenger, per-booking add-on, priced by Admin-configured default
// (seeded ₹5,000), requiring mandatory T&C acceptance before it can move to
// PURCHASED, gated by a staff eligibility review (never fully automated —
// New_Visa.md §8 itself: "OCR can flag possible issues, but OCR is not the
// final decision-maker").
//
// Addressed by (bookingId, passengerId), NOT a FK to BookingPassenger's own
// row id — matching this schema's own existing convention (PATCH
// /api/bookings/[id]/passengers/[passengerId]/status, Step 14, already
// addresses "this passenger within this booking" the same way, and the
// Booking detail API doesn't even expose BookingPassenger's own row id
// today). Reusing that shape keeps this consistent with the rest of the
// booking-passenger surface rather than introducing a second addressing
// scheme.
// ---------------------------------------------------------------------------

/// Exact 14-status list from New_Visa.md §9 — do not rename/reorder/add to
/// this without re-reading that section; the prompt for this step
/// explicitly required transcribing it verbatim, not inventing names.
enum ProtectionPlanStatus {
  NOT_OFFERED
  OFFERED
  SELECTED_TERMS_PENDING
  TERMS_ACCEPTED
  PURCHASED
  UNDER_ELIGIBILITY_REVIEW
  ELIGIBLE
  INELIGIBLE
  CANCELLED
  REFUND_UNDER_REVIEW
  REFUND_APPROVED
  REFUND_REJECTED
  REFUND_PROCESSING
  REFUND_COMPLETED
}

/// True singleton (same pattern as TaxFeeConfig) — Admin-configurable
/// default price and, since New_Visa.md §8 never gives literal T&C prose or
/// a final eligibility-condition list ("other configured exclusions"),
/// admin-editable text/list fields instead of hard-coded strings so the
/// real legal copy can be entered without a code change (seeded with an
/// obviously-labeled SAMPLE terms text per CLAUDE.md hard rule #1 — the
/// eligibility conditions themselves ARE given verbatim in §8, so those are
/// seeded for real, not as samples).
model ProtectionPlanConfig {
  id                    String   @id
  defaultPrice          Decimal  @db.Decimal(10, 2)
  termsText             String
  /// String array (e.g. ["Fresh/first-time passport", ...]) — §8's own
  /// eligibility list, editable so Admin can add "other configured
  /// exclusions" without a migration.
  eligibilityConditions Json
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model ProtectionPlan {
  id              String               @id @default(cuid())
  bookingId       String
  passengerId     String
  status          ProtectionPlanStatus @default(NOT_OFFERED)
  /// Snapshotted from ProtectionPlanConfig.defaultPrice at offer time — same
  /// config-snapshot precedent as Quotation.sellingPrice (ADMIN.md §11:
  /// "paid bookings retain committed configuration"), so a later admin price
  /// change doesn't alter an already-offered/purchased plan.
  price           Decimal              @db.Decimal(10, 2)
  /// Set only once, when status first reaches PURCHASED — "mandatory
  /// acceptance... without agreement the Protection Plan cannot be
  /// purchased" (§8). No separate terms-text snapshot column: the
  /// AuditTrail row written at that moment already carries the exact
  /// ProtectionPlanConfig.termsText shown, which is enough to prove what
  /// was accepted without duplicating the text on every row.
  termsAcceptedAt DateTime?
  /// Staff-entered free text when moving to INELIGIBLE or REFUND_REJECTED —
  /// no fixed reason-code list is specified anywhere in the source doc.
  decisionNote    String?
  /// Only ever set to `price` (full refund) — no partial-refund tier is
  /// specified for Protection Plan anywhere in New_Visa.md, unlike the
  /// service-level refund rules in src/lib/refunds/rules.ts.
  refundAmount    Decimal?             @db.Decimal(10, 2)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  booking   Booking   @relation(fields: [bookingId], references: [id])
  passenger Passenger @relation(fields: [passengerId], references: [id])

  @@unique([bookingId, passengerId])
  @@index([bookingId])
  @@index([passengerId])
  @@index([status])
}

/// Return_Verified_Ticket.md §6, locked: "The exact date calculation must be
/// configurable rather than hard-coded if Admin needs to change the
/// operational rule." A true singleton, same pattern as TaxFeeConfig — the
/// return/onward date is never customer-entered (see ReturnTicketVisaType
/// and computeReturnDate() in src/lib/leads/compute-return-date.ts); it's
/// travelDate + the configured offset for the selected visa type. No
/// dedicated Admin UI ships in this step (out of this step's scope — see
/// the roadmap's Step 10 prompt, which asks for the customer-facing flow +
/// server-side computation, not a new Admin screen); the row is still
/// DB-editable without a deploy, which is what the locked rule requires.
/// Admin-managed destinations for the Return Verified Ticket service (client
/// update: no longer UAE-only — any Middle East country the admin enables,
/// each with its own per-applicant rate and allowed visa-validity options).
/// `validityOptions` holds ReturnTicketVisaType values ("THIRTY_DAYS" |
/// "SIXTY_DAYS" | "NINETY_DAYS").
model ReturnTicketDestination {
  id               String   @id @default(cuid())
  countryId        String   @unique
  ratePerApplicant Decimal  @db.Decimal(10, 2)
  validityOptions  String[]
  active           Boolean  @default(true)
  displayOrder     Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id])

  @@index([active])
}

/// Admin-managed New Visa pricing (Step 35, client answer 2026-09-23: "pay
/// right after the form" — the price must be auto-computable, not
/// staff-quoted). Dimensions taken directly from what New_Visa.md's own
/// locked flow already asks the customer for and shows before payment:
/// destination country, Normal/Express processing, and separate Adult/Child
/// pricing (§6/§8, locked rule — "Adult/Child pricing is separate").
/// `visaType` (the sample tourist/business/etc. categories) is deliberately
/// NOT a pricing dimension here — those are still illustrative sample
/// options (see SAMPLE_VISA_TYPE_OPTIONS), and pricing by an invented
/// category would be worse than not pricing by it at all; revisit if the
/// client gives a real, final visa-type list.
model NewVisaPricing {
  id             String   @id @default(cuid())
  countryId      String
  /// "normal" | "urgent" — matches the existing processingType values used elsewhere (OTB, this form's own step).
  processingType String
  adultPrice     Decimal  @db.Decimal(10, 2)
  childPrice     Decimal  @db.Decimal(10, 2)
  infantPrice    Decimal  @db.Decimal(10, 2)
  active         Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id])

  @@unique([countryId, processingType])
  @@index([active])
}

model ReturnTicketRuleConfig {
  id                  String   @id
  thirtyDayOffsetDays Int
  sixtyDayOffsetDays  Int
  ninetyDayOffsetDays Int      @default(90)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Staff / RBAC
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  roleId       String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role                        Role                 @relation(fields: [roleId], references: [id])
  assignedLeads               Lead[]
  auditEntries                AuditTrail[]
  reviewedDocumentExtractions DocumentExtraction[]
  assignedTasks               Task[]               @relation("TaskAssignee")
  completedTasks              Task[]               @relation("TaskCompletedBy")
  sentWhatsAppMessages        WhatsAppMessageLog[]
  leaves                      StaffLeave[]
  approvedLeaves              StaffLeave[]         @relation("StaffLeaveApprovals")
  recordedExpenses            Expense[]

  @@index([roleId])
  @@index([active])
}

/// Step 38 (Tier 2 §2): PENDING (staff-requested, not yet decided) /
/// APPROVED / REJECTED. Admin-created leave (POST /api/admin/staff-leave)
/// is created directly as APPROVED — an admin recording an entry for a
/// staff member is already the authoritative decision, no separate approve
/// click needed. Only a staff member's own self-requested leave
/// (POST /api/staff-leave) starts PENDING.
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Step 38: "keep it simple unless the client specifies categories" — no
/// category list was ever given, so this is the roadmap prompt's own
/// suggested starter set, not client-sourced domain data.
enum LeaveType {
  SICK
  CASUAL
  OTHER
}

/// Step 26 Unit 3 (audit §3.11/§4.7) — ADMIN.md §13's "Staff leave" roster:
/// "1. Staff becomes unavailable. 2. Affected open work is identified.
/// 3. Replacement staff can be recommended." This model covers step 1 (and
/// feeds step 2/3's UI — see src/lib/staff/eligible-for-assignment.ts,
/// which excludes a staff member from auto-assignment suggestions only
/// while they have a current APPROVED leave row — Step 38 gated this on
/// status; it used to fire on any overlapping row regardless of approval).
/// A plain date-range row per leave period, not a single "on leave: yes/no"
/// flag — a staff member can have multiple leave periods over time, and
/// this keeps the full history rather than only ever knowing the current
/// state.
model StaffLeave {
  id               String      @id @default(cuid())
  userId           String
  startDate        DateTime    @db.Date
  endDate          DateTime    @db.Date
  reason           String?
  status           LeaveStatus @default(PENDING)
  type             LeaveType   @default(OTHER)
  approvedByUserId String?
  approvedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user       User  @relation(fields: [userId], references: [id])
  approvedBy User? @relation("StaffLeaveApprovals", fields: [approvedByUserId], references: [id])

  @@index([userId])
  @@index([startDate])
  @@index([endDate])
  @@index([status])
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       User[]
  permissions Permission[] @relation("RolePermissions")
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles Role[] @relation("RolePermissions")
}

// ---------------------------------------------------------------------------
// Automation (n8n background workflows) — Phase 5E
// ---------------------------------------------------------------------------

enum AutomationRunStatus {
  SUCCESS
  FAILURE
}

/// One row per invocation of an /api/automation/* endpoint — this is what
/// the Admin "Automation" monitoring screen reads to show last run/success-
/// failure per workflow. `workflowKey` matches the n8n workflow's own
/// identifier (see AUTOMATION_WORKFLOWS.md) — a free string, same rationale
/// as NotificationTemplate.event: the real key names live in
/// src/lib/automation/workflows.ts, not a DB-locked enum.
model AutomationRun {
  id           String              @id @default(cuid())
  workflowKey  String
  status       AutomationRunStatus
  /// Whatever the job wants to report — e.g. {"remindersSent": 3, "expired": 1, "checked": 40}.
  summary      Json?
  errorMessage String?
  startedAt    DateTime
  finishedAt   DateTime
  createdAt    DateTime            @default(now())

  @@index([workflowKey, createdAt])
}

/// Dedupe/cooldown tracking so a periodic job (n8n calling the same
/// endpoint every N minutes) doesn't re-notify about the same thing every
/// run — e.g. only one QUOTE_REMINDER per quotation, or a LEAD_FOLLOWUP
/// nudge at most once per cooldown window per lead. Deliberately generic
/// across every reminder-style job rather than adding a bespoke
/// `reminderSentAt` column to Quotation/Payment/Lead/Document individually.
model AutomationReminderLog {
  id         String   @id @default(cuid())
  event      String
  entityType String
  entityId   String
  sentAt     DateTime @default(now())

  @@index([event, entityType, entityId, sentAt])
}

/// Admin-managed occupation options for the New Visa traveller form (client:
/// starts as Employee / Business / Retired / Student / Housewife / None, and
/// Admin can add and remove options). Leads store the chosen name as text, so
/// removing an option never affects existing requests.
model Occupation {
  id           String   @id @default(cuid())
  name         String   @unique
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

/// Global OTB processing timelines, used whenever an airline has no
/// override of its own. Singleton row (fixed id), same pattern as
/// TaxFeeConfig. `standardProcessingDays` is WORKING DAYS (client-confirmed
/// 24); `urgentProcessingHours` is WORKING HOURS (client-confirmed 8,
/// 2026-09-23) — a deliberately different unit, not a smaller day count.
model OtbRuleConfig {
  id                     String   @id
  standardProcessingDays Int
  urgentProcessingHours  Int?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

/// File bytes stored in the database — the fallback for hosts with no
/// writable disk (e.g. serverless), until a real object store (S3/Cloudinary)
/// is connected. Served by GET /api/files/[id]; the id is a random UUID.
model FileBlob {
  id        String   @id
  mimeType  String
  data      Bytes
  createdAt DateTime @default(now())
}
